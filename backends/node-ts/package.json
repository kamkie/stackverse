{
  "name": "@stackverse/backend-node-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "yarn build && node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"migrations/**/*.cjs\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"migrations/**/*.cjs\" \"*.{js,json,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
